# ====================================================================
# Variáveis de ambiente — PLATAFORMA DE INTELIGÊNCIA AUTOMOTIVA
# ====================================================================
# Copie este arquivo para `.env.local` e preencha os valores reais.
# NUNCA faça commit de .env.local — ele está no .gitignore por segurança.
# ====================================================================

# --- Supabase (banco de dados + autenticação) ---
# Será configurado na Iteração 2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (IA) ---
# Será configurado na Iteração 5
GOOGLE_GEMINI_API_KEY=

# --- Configurações de execução do pipeline semanal ---
PIPELINE_SECRET=
PIPELINE_MAX_TOKENS_PER_RUN=200000
PIPELINE_MAX_ARTICLES_PER_RUN=200
